{
  "name": "nuvio-plugins",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nuvio JavaScript provider manifest and merged CloudStream extension index",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-nuvio.mjs",
    "build:cloudstream": "node scripts/build.mjs",
    "build:nuvio": "node scripts/build-nuvio.mjs",
    "build:offline": "node scripts/build.mjs --offline",
    "validate": "node scripts/validate.mjs && node scripts/validate-nuvio.mjs"
  }
}
